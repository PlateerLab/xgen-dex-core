{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dex/protocol": ["../../packages/protocol/src/index.ts"],
      "@dex/protocol/*": ["../../packages/protocol/src/*"]
    }
  },
  "include": ["src", "test", "capacitor.config.ts", "vite.config.ts"]
}
