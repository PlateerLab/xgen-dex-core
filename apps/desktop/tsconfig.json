{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@dex/protocol": ["packages/protocol/src/index.ts"],
      "@dex/protocol/*": ["packages/protocol/src/*"],
      "@dex/engine": ["packages/engine/src/index.ts"],
      "@dex/engine/*": ["packages/engine/src/*"],
      "@dex/rpc": ["packages/rpc/src/index.ts"],
      "@dex/rpc/*": ["packages/rpc/src/*"]
    }
  },
  "include": ["src", "test", "../../packages/*/src"]
}
