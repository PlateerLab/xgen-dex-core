{
  "name": "@dex/ide",
  "version": "1.81.1",
  "private": true,
  "type": "module",
  "description": "채팅 안의 IDE 보기 — 탐색기·편집기·터미널·찾기·소스 제어 (React, 호스트 주입)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ide.css": "./src/ide.css",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
